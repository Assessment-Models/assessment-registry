{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assessment-models.github.io/assessment-registry/schemas/registration.schema.json",
  "title": "Assessment Ecosystem Registration Record",
  "description": "One registration record per ecosystem asset (CR-AM-11 section 11). Metadata and immutable references only - never model content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "name", "source", "release", "conformsTo", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Canonical asset identifier. Equals the filename stem."
    },
    "type": {
      "type": "string",
      "enum": ["maturity-model", "assessment-model", "assessment-tool", "component"]
    },
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "repository"],
      "properties": {
        "organization": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "reference"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.-]+)?$",
          "description": "SemVer release version."
        },
        "reference": {
          "type": "string",
          "description": "IMMUTABLE reference: tag vX.Y.Z, 40-char commit SHA, or sha256 digest. main/master/latest/HEAD are forbidden (CR-AM-11 section 12)."
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Optional full commit SHA corroborating the tag reference."
        }
      }
    },
    "conformsTo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract"],
      "properties": {
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["active", "legacy", "candidate-for-migration", "reference", "deprecated", "superseded"]
    },
    "components": {
      "type": "array",
      "description": "Reusable component references consumed by this asset (CR-AM-11 section 20).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "reference"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "type": {"type": "string"},
          "version": {"type": "string"},
          "reference": {"type": "string", "description": "Immutable reference to the component release."}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "description": "Other registered asset ids this asset depends on.",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    },
    "notes": {"type": "string"}
  }
}
